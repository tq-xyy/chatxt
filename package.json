        "chalk": "^6.0.0",
        "commander": "^15.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.2.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.8.1",
        "prettier": "^3.9.6",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "eslint-config-prettier": "^10.1.8",
        "typescript-eslint": "^8.67.0"
    }
